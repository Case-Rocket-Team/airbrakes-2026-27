CXX = g++
C = gcc

BASE = -O2
CFLAGS = -std=c11 $(BASE)
CXXFLAGS = -std=c++17 $(BASE)
LFLAGS =  -fPIC -shared

INCLUDE = -I/usr/include/python3.14/
INCLUDELIB= $(INCLUDE) -I.
INCLUDEXE = $(INCLUDE) -I..

LIBS = -lairbrakes -lairbrakesControl
LIBFLAGS = -L. $(LIBS) -Wl,-rpath,'.'

LIBFILES = control/controller/slew_mpc.cpp control/controller/ideal_mpc.cpp control/actuator/actuator_model.cpp control/physics/dynamics.cpp control/aero/brake_aero.cpp control/predictor/apogee_predictor.cpp control/physics/drag.cpp control/physics/atmosphere.cpp

.SILENT:
MAKEFLAGS += --no-print-directory

default_target: all
.PHONY : default_target

all: libso buildc run
.PHONY : all

libso:
	cd .. && $(C) $(CFLAGS) $(LFLAGS) $(INCLUDELIB) base/base.c -o libairbrakes.so
	cd .. && $(CXX) $(CXXFLAGS) $(LFLAGS) $(INCLUDELIB) $(LIBFILES) -o libairbrakesControl.so
	mv ../libairbrakes.so libairbrakes.so
	mv ../libairbrakesControl.so libairbrakesControl.so
.PHONY : lib

buildc:
	 $(CXX) $(CXXFLAGS) $(LFLAGS) $(INCLUDEXE) $(LIBFLAGS) ControlBind.cpp -o ControlBind$(shell python3-config --extension-suffix)
.PHONY : buildc

run:
	python3 test.py
.PHONY : run

clean:
	rm -f libairbrakes.so  libairbrakesControl.so ControlBind$(shell python3-config --extension-suffix)
.PHONY : clean
